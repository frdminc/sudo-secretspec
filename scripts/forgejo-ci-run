#!/usr/bin/env bash
# forgejo-ci-run — push HEAD to the private Forgejo duplicate (branch ci-run)
# and wait for its CI run to conclude. Exit 0 only on a green run.
# Registered with `load-watch ci-only add`; use this instead of local cargo.
set -euo pipefail
TOP="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO="djbclark/sudo-secretspec"
FORGEJO_SCRIPTS="${FORGEJO_SCRIPTS:-$HOME/src/djbclark-ade/skills/forgejo/scripts}"
WAIT_RUN="${FORGEJO_CI_WAIT_RUN:-$HOME/src/loopback-port-shim/ci/tools/wait-run.sh}"

sha="$(git -C "$TOP" rev-parse HEAD)"
"$FORGEJO_SCRIPTS/git-forgejo" -C "$TOP" push --force forgejo "HEAD:refs/heads/ci-run"
out="$(mktemp -t forgejo-ci-run.XXXXXX)"
RP="$REPO" WAIT_MAX="${WAIT_MAX:-1800}" "$WAIT_RUN" "$sha" "$out"
cat "$out.status"
tail -40 "$out" || true
grep -q 'status=success' "$out.status"

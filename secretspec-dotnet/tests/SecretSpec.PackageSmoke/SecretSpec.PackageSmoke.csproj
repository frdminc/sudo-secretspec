<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.21.1-sudo.7</Version>
    <!-- Keep the NativeAOT compiler and runtime packs on the same patched
         8.0.34 release (GHSA-p3jp-9v83-76w9). A compiler-only pin that
         lags the runtime pack fails publish with "Overriding
         System.Private.CoreLib.dll". The artifact-only priming restore
         cannot see Microsoft packages, so both are skipped then. -->
    <RuntimeFrameworkVersion Condition="'$(SecretSpecArtifactOnlyRestore)' != 'true'">8.0.34</RuntimeFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cachix.SecretSpec" Version="$(Version)" />
    <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="8.0.34"
                      Condition="'$(SecretSpecArtifactOnlyRestore)' != 'true'" />
  </ItemGroup>
</Project>

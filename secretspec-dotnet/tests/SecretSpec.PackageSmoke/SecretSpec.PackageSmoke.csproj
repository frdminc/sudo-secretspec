<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.21.1-sudo.7</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cachix.SecretSpec" Version="$(Version)" />
    <!-- Patched compiler pack so NativeAOT restore does not pull an
         unpatched Microsoft.DotNet.ILCompiler (NU1903 / GHSA-p3jp-9v83-76w9)
         on runners whose 8.0 SDK is older than 8.0.33. CI first restores
         from the just-built package folder alone (which has no Microsoft
         packages) and sets SecretSpecArtifactOnlyRestore=true for that step,
         so the pin applies only to the later restores that can reach NuGet.org. -->
    <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="8.0.33"
                      Condition="'$(SecretSpecArtifactOnlyRestore)' != 'true'" />
  </ItemGroup>
</Project>
